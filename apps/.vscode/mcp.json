{
	"servers": {
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp", "--api-key", "$CONTEXT7_API_KEY"]
		},
		"ddg-search": {
			"type": "stdio",
			"command": "uvx",
			"args": ["duckduckgo-mcp-server"]
		},
		"sequential-thinking": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		}
	},
	"inputs": []
}
