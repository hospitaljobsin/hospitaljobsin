{% extends "emails/base/body.mjml" %}

{% block title %}
{% if job_count == 1 %}
  New Job Found!
{% else %}
  {{ job_count }} New Jobs Found!
{% endif %}
{% endblock %}

{% block content %}
<mj-text color="#1f2937" font-size="16px" line-height="1.5" padding="0 0 16px 0">
  Hi {{ job_alert.account.full_name }},
</mj-text>

<mj-text color="#374151" font-size="14px" line-height="1.6" padding="0 0 24px 0">
  Exciting news! We've discovered
  {% if job_count == 1 %}
    an amazing new opportunity
  {% else %}
    {{ job_count }} fantastic new opportunities
  {% endif %}
  that match your job alert for <strong>{{ job_alert.filters.search_term }}</strong>. Your dream job might be just one click away! 🚀
</mj-text>

{% for job in jobs %}
<!-- Job Card -->
<mj-section background-color="#ffffff" border="1px solid #e5e7eb" border-radius="12px">
  <!-- Logo and Job Info -->
  <mj-column width="20%" padding="24px 24px 24px 24px">
    <mj-text padding="0" margin="0">
      <a href="{{ app_url }}/organizations/{{ job.organization.slug }}/jobs/{{ job.slug }}" style="text-decoration: none; color: inherit; display: block;">
        {% if job.organization.logo_url %}
          <img src="{{ job.organization.logo_url }}" alt="{{ job.organization.name }} logo" width="48" height="48" style="border-radius: 8px; display: block;" />
        {% else %}
          <div style="width: 48px; height: 48px; border-radius: 8px; background-color: #f3f4f6; display: flex; align-items: center; justify-content: center; font-weight: 600; color: #6b7280; font-size: 16px;">
            {{ job.organization.name[0] if job.organization.name else 'C' }}
          </div>
        {% endif %}
      </a>
    </mj-text>
  </mj-column>

  <!-- Job Title and Company -->
  <mj-column width="55%" padding="8px 24px 24px 24px">
    <mj-text>
      <a href="{{ app_url }}/organizations/{{ job.organization.slug }}/jobs/{{ job.slug }}" style="text-decoration: none; color: inherit; display: block;">
        <div style="color: #1f2937; font-size: 18px; font-weight: 600; line-height: 1.3; margin-bottom: 4px;">{{ job.title }}</div>
        <div style="color: #6b7280; font-size: 14px; font-weight: 500;">{{ job.organization.name }}</div>
      </a>
    </mj-text>
  </mj-column>

  <!-- Salary -->
  <mj-column width="25%" padding="8px 24px 24px 24px">
    <mj-text align="left">
      <a href="{{ app_url }}/organizations/{{ job.organization.slug }}/jobs/{{ job.slug }}" style="text-decoration: none; color: inherit; display: block;">
        <div style="color: #1f2937; font-size: 16px; font-weight: 600; line-height: 1.2; text-align: left;">
          {% if job.min_salary and job.max_salary %}
            ₹ Not disclosed
          {% elif job.min_salary %}
            ₹ {{ "{:,}".format(job.min_salary) }}+
          {% else %}
            ₹ Not disclosed
          {% endif %}
        </div>
      </a>
    </mj-text>
  </mj-column>

  <!-- Job Details Row -->
  <mj-column padding="8px 24px 24px 24px">
    <mj-text padding="0" margin="0">
      <a href="{{ app_url }}/organizations/{{ job.organization.slug }}/jobs/{{ job.slug }}" style="text-decoration: none; color: inherit; display: block;">

        <!-- Posted Date -->
        <div style="color: #9ca3af; font-size: 13px; font-weight: 500; margin-bottom: 12px;">
          Posted on {{ job.id.generation_time.strftime('%B %d, %Y') if job.id and job.id.generation_time else 'Recently' }}
        </div>

        <!-- Job Details -->
        <div style="color: #374151; font-size: 14px; font-weight: 500; margin-bottom: 16px; line-height: 1.4;">
          {% set details = [] %}
          {% if job.type %}
            {% set _ = details.append(job.type|title|replace("_", " ")) %}
          {% endif %}
          {% if job.location %}
            {% set _ = details.append("📍 " + job.location) %}
          {% endif %}
          {% if job.min_experience is not none and job.max_experience is not none %}
            {% set _ = details.append(job.min_experience|string + " - " + job.max_experience|string + " years") %}
          {% elif job.min_experience is not none %}
            {% set _ = details.append(job.min_experience|string + "+ years") %}
          {% endif %}
          {% if job.work_mode %}
            {% set _ = details.append(job.work_mode|title) %}
          {% endif %}
          {{ details | join(" • ") }}
        </div>

        <!-- Skills Tags -->
        <div style="line-height: 1.4;">
          {% if job.skills %}
            {% for skill in job.skills[:5] %}
              <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
                {{ skill.name if skill.name else skill }}
              </span>
            {% endfor %}
          {% else %}
            <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
              Packaging
            </span>
            <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
              Dispatch
            </span>
            <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
              Documentation
            </span>
            <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
              Accuracy
            </span>
            <span style="display: inline-block; background-color: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 16px; font-size: 12px; font-weight: 500; margin: 0 6px 6px 0; border: 1px solid #e2e8f0; white-space: nowrap;">
              Multitasking
            </span>
          {% endif %}
        </div>
      </a>
    </mj-text>
  </mj-column>
</mj-section>

<!-- Spacer between job cards -->
<mj-spacer height="20px" />
{% endfor %}

{% if has_more_jobs %}
<mj-section padding="0">
  <mj-column>
    <mj-button href="{{ search_url }}" color="#ffffff" border-radius="10px" font-weight="500" padding="0" font-size="16px" line-height="1.3" width="100%">
      View all jobs
    </mj-button>
  </mj-column>
</mj-section>
{% endif %}

<mj-section padding="24px 0 0 0">
  <mj-column>
    <mj-text color="#3182ce" font-size="14px" margin="0" align="left">
      <a href="{{ app_url }}/my-alerts" target="_blank" style="color: #3182ce; text-decoration: none; font-weight: 500;">
        Manage your job alerts
      </a>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="16px 0 0 0">
  <mj-column>
    <mj-text color="#718096" font-size="14px" margin="0" line-height="1.5">
      Happy job hunting! 🎯
    </mj-text>
  </mj-column>
</mj-section>
{% endblock %}
