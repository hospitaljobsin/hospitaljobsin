{% extends "emails/base/body.mjml" %}

{% block title %}
{% if job_count == 1 %}
  New Job Found!
{% else %}
  {{ job_count }} New Jobs Found!
{% endif %}
{% endblock %}

{% block content %}
<mj-text>Hi {{ job_alert.account.full_name }},</mj-text>

<mj-text>
  Exciting news! We've discovered
  {% if job_count == 1 %}
    an amazing new opportunity
  {% else %}
    {{ job_count }} fantastic new opportunities
  {% endif %}
  that match your job alert for <strong>{{ job_alert.filters.search_term }}</strong>. Your dream job might be just one click away! 🚀
</mj-text>

{% for job in jobs %}
<!-- Job Card -->
<mj-wrapper href="{{ app_url }}/organizations/{{ job.organization.slug }}/jobs/{{ job.slug }}" background-color="#ffffff" border="1px solid #e5e7eb" border-radius="8px" padding="20px" css-class="job-card">
  <!-- Job Header with Logo, Title, Company and Salary -->
  <mj-section padding="0 0 12px 0">
    <mj-column width="48px" padding="0 12px 0 0">
      <mj-image src="{{ job.organization.logo_url }}" alt="{{ job.organization.name }} logo" width="40px" height="40px" border-radius="6px" align="left" fluid-on-mobile="false" />
    </mj-column>
    <mj-column padding="0">
      <mj-text color="#1f2937" font-size="18px" font-weight="600" line-height="1.3" margin="0 0 2px 0">{{ job.title }}</mj-text>
      <mj-text color="#6b7280" font-size="14px" font-weight="400" margin="0">{{ job.organization.name }}</mj-text>
    </mj-column>
    <mj-column width="100px" padding="0">
      {% if job.min_salary and job.max_salary %}
      <mj-text align="right" color="#1f2937" font-size="16px" font-weight="600" line-height="1.2" margin="0">
        ₹ Not disclosed
      </mj-text>
      {% elif job.min_salary %}
      <mj-text align="right" color="#1f2937" font-size="16px" font-weight="600" line-height="1.2" margin="0">
        ₹ {{ "{:,}".format(job.min_salary) }}+
      </mj-text>
      {% else %}
      <mj-text align="right" color="#1f2937" font-size="16px" font-weight="600" line-height="1.2" margin="0">
        ₹ Not disclosed
      </mj-text>
      {% endif %}
    </mj-column>
  </mj-section>

  <!-- Posted Date -->
  <mj-section padding="0 0 8px 0">
    <mj-column>
      <mj-text color="#9ca3af" font-size="12px" margin="0">
        Posted on {{ job.id.generation_time.strftime('%B %d, %Y') if job.id and job.id.generation_time else 'Recently' }}
      </mj-text>
    </mj-column>
  </mj-section>

  <!-- Job Details -->
  <mj-section padding="0 0 12px 0">
    <mj-column>
      <mj-text color="#374151" font-size="13px" margin="0">
        {% set details = [] %}
        {% if job.type %}
          {% set _ = details.append(job.type|title|replace("_", " ")) %}
        {% endif %}
        {% if job.location %}
          {% set _ = details.append("📍 " + job.location) %}
        {% endif %}
        {% if job.min_experience is not none and job.max_experience is not none %}
          {% set _ = details.append(job.min_experience|string + " - " + job.max_experience|string + " years") %}
        {% elif job.min_experience is not none %}
          {% set _ = details.append(job.min_experience|string + "+ years") %}
        {% endif %}
        {% if job.work_mode %}
          {% set _ = details.append(job.work_mode|title) %}
        {% endif %}
        {{ details | join(" • ") }}
      </mj-text>
    </mj-column>
  </mj-section>

  <!-- Skills Tags -->
  <mj-section padding="0">
    <mj-column>
      <mj-text margin="0">
        {% if job.skills %}
          {% for skill in job.skills[:5] %}
            <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
              {{ skill.name if skill.name else skill }}
            </span>
          {% endfor %}
        {% else %}
          <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
            Packaging
          </span>
          <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
            Dispatch
          </span>
          <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
            Documentation
          </span>
          <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
            Accuracy
          </span>
          <span style="display: inline-block; background-color: #f8fafc; color: #64748b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 500; margin-right: 6px; margin-bottom: 4px; border: 1px solid #e2e8f0;">
            Multitasking
          </span>
        {% endif %}
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

<!-- Spacer between job cards -->
<mj-spacer height="16px" />
{% endfor %}

{% if has_more_jobs %}
<mj-section padding="32px 0">
  <mj-column>
    <mj-button href="{{ search_url }}" background-color="#3b82f6" color="#ffffff" border-radius="8px" font-weight="600" font-size="16px" padding="14px 28px">
      View All Jobs
    </mj-button>
  </mj-column>
</mj-section>
{% endif %}

<mj-text padding-top="24px">
  <a href="{{ app_url }}/my-alerts" target="_blank" style="color: #3182ce; text-decoration: none;">
    Manage your job alerts
  </a>
</mj-text>

<mj-text color="#718096" font-size="14px" padding-top="16px">
  Happy job hunting! 🎯
</mj-text>
{% endblock %}
