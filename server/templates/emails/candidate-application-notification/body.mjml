{% extends "emails/base/body.mjml" %} {% block title %} {% if applicant_count ==
1 %} New Application Received! {% else %} {{ applicant_count }} New Applications
Received! {% endif %} {% endblock %} {% block content %}
<mj-text
  color="#1f2937"
  font-size="16px"
  line-height="1.5"
  padding="0 0 16px 0"
>
  Hi {{ recruiter_name }},
</mj-text>

<mj-text
  color="#374151"
  font-size="14px"
  line-height="1.6"
  padding="0 0 24px 0"
>
  {% if applicant_count == 1 %} You have received a new application for the
  <strong>{{ job.title }}</strong> position. Please review the candidate's
  profile below. {% else %} You have received {{ applicant_count }} new
  applications for the <strong>{{ job.title }}</strong> position. Please review
  the candidate profiles below. {% endif %}
</mj-text>

{% for applicant in applicants %}
<!-- Applicant Card -->
<mj-wrapper
  background-color="#ffffff"
  border="1px solid #e5e7eb"
  border-radius="12px"
  padding="0"
>
  <mj-section background-color="#ffffff" padding="24px 20px">
    <!-- Header Row: Name and Applied Date -->
    <mj-column width="70%" padding="0 16px 12px 0">
      <mj-text padding="0" margin="0">
        <a
          href="{{applicants_url }}/{{ applicant.slug }}"
          style="text-decoration: none; color: inherit; display: block"
        >
          <div
            style="
              color: #1f2937;
              font-size: 20px;
              font-weight: 600;
              line-height: 1.3;
              margin-bottom: 6px;
            "
          >
            {{ applicant.account_full_name }}
          </div>
          {% if applicant.profile_snapshot.headline %}
          <div
            style="
              color: #6b7280;
              font-size: 15px;
              font-weight: 500;
              margin-bottom: 8px;
            "
          >
            {{ applicant.profile_snapshot.headline }}
          </div>
          {% endif %}
        </a>
      </mj-text>
    </mj-column>

    <mj-column width="30%" padding="0 0 12px 0">
      <mj-text padding="0" margin="0" align="right">
        <a
          href="{{applicants_url}}/{{ applicant.slug }}"
          style="text-decoration: none; color: inherit; display: block"
        >
          <div
            style="
              color: #9ca3af;
              font-size: 13px;
              font-weight: 500;
              text-align: right;
            "
          >
            Applied on {{ applicant.id.generation_time.strftime('%b %d, %Y') if
            applicant.id and applicant.id.generation_time else 'Recently' }}
          </div>
        </a>
      </mj-text>
    </mj-column>

    <!-- Details Row -->
    <mj-column width="100%" padding="8px 0 0 0">
      <mj-text padding="0" margin="0">
        <a
          href="{{applicants_url}}/{{ applicant.slug }}"
          style="text-decoration: none; color: inherit; display: block"
        >
          <div
            style="
              color: #374151;
              font-size: 14px;
              font-weight: 500;
              line-height: 1.5;
            "
          >
            {% set details = [] %} {% if
            applicant.profile_snapshot.career_profile and
            applicant.profile_snapshot.career_profile.locations_open_to_work %}
            {% set _ = details.append("📍 " +
            (applicant.profile_snapshot.career_profile.locations_open_to_work |
            join(", "))) %} {% endif %} {% if
            applicant.profile_snapshot.resume_url %} {% set _ =
            details.append("📄 Resume attached") %} {% endif %} {{ details |
            join(" • ") if details else "No additional details" }}
          </div>
        </a>
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

<!-- Spacer between applicant cards -->
<mj-spacer height="20px" />
{% endfor %}

<mj-section padding="0">
  <mj-column>
    <mj-button
      href="{{ applicants_url }}"
      color="#ffffff"
      border-radius="10px"
      font-weight="500"
      padding="0"
      font-size="16px"
      line-height="1.3"
      width="100%"
    >
      View All Applicants
    </mj-button>
  </mj-column>
</mj-section>

<mj-section padding="24px 0 0 0">
  <mj-column>
    <mj-text color="#3182ce" font-size="14px" margin="0" align="left">
      <a
        href="{{ manage_jobs_url }}"
        target="_blank"
        style="color: #3182ce; text-decoration: none; font-weight: 500"
      >
        Manage your job postings
      </a>
    </mj-text>
  </mj-column>
</mj-section>
{% endblock %}
