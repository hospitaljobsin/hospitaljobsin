<mjml>
  <mj-head>
    <mj-title>{% block title %}{% endblock %}</mj-title>
    <mj-preview>{% block preview %}Your healthcare career opportunities await{% endblock %}</mj-preview>
    <mj-breakpoint width="640px" />
    <mj-attributes>
      <mj-all font-family="Work Sans, Open Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif" />
      <mj-body background-color="#f8fafa" />
      <mj-section padding="0" />
      <mj-text color="#1f2937" font-size="16px" line-height="1.6" padding="0" />
      <mj-button background-color="#00a925" color="#ffffff" border="none" border-radius="8px" font-size="16px" font-weight="600" padding="12px 24px" text-transform="none" />
    </mj-attributes>

    <mj-style>
      .header-gradient {
        background: linear-gradient(135deg, #4db866 0%, #4db866 100%);
      }
      .content-card {
        background: #ffffff;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .brand-text {
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
      }
      .view-browser {
        color: #ffffff;
        text-decoration: none;
        opacity: 0.9;
      }
      .footer-text {
        color: #6b7280;
        font-size: 14px;
      }
      .inner-wrapper {
        max-width: 800px;
        margin: 0 auto;
        border-radius: 16px;
        overflow: hidden;
        display: block;
      }

      .footer-wrapper {
        max-width: 800px;
        margin: 0 auto;
        overflow: hidden;
        display: block;
      }

      /* Mobile responsive styles */
      @media only screen and (max-width: 640px) {
        .app-name-text {
          font-size: 16px !important;
        }
        .app-tagline-text {
          display: none !important;
        }
        .hero-container {
          height: 150px !important;
        }
        .hero-container img {
          height: 150px !important;
        }
        .hide-mobile {
          display: none !important;
        }
        .show-mobile {
          display: table-cell !important;
        }
        .footer-mobile span {
          display: block !important;
          margin: 8px 0 !important;
          text-align: center !important;
        }
        .footer-mobile .social-icons {
          margin-top: 12px !important;
        }
      }

      /* Desktop styles */
      @media only screen and (min-width: 641px) {
        .show-mobile {
          display: none !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="100%" background-color="#E4E4E7">
    <!-- Outer full-width grey container -->
    <mj-section background-color="#E4E4E7" padding="24px 24px 0px 24px">
      <mj-column width="100%">
        <mj-wrapper padding="0" css-class="inner-wrapper">
    <!-- Header Section with Brand Colors -->
    <mj-section css-class="header-gradient" padding="0 20px">
      <mj-column width="60%" padding="16px 0">
        <mj-text align="left" color="#ffffff" font-size="24px" font-weight="600" padding="0">
          <span style="display: inline-flex; align-items: center; font-size: 24px;">
            <img src="{{ app_logo_url }}" alt="{{ app_name }} logo" style="width: 32px; height: 32px; border-radius: 50%; margin-right: 12px;" />
            <span class="app-name-text">{{ app_name }}</span>
          </span>
        </mj-text>
        <mj-text align="left" padding="0" color="#F4F4F5" font-size="20px">
          <span class="app-tagline-text">{{ app_tagline }}</span>
        </mj-text>
      </mj-column>
      <mj-column width="40%">
        <mj-text align="right" padding="0" width="100%">
          <div class="hero-container" style="position: relative; height: 250px; overflow: hidden;">
            <img src="{{ hero_image_1_url }}" alt="Healthcare Professional 1" style="width: auto; height: 250px; max-width: 100%; object-fit: cover; object-position: bottom; position: absolute; left: 0; top: 0; z-index: 10;" />
            <img src="{{ hero_image_2_url }}" alt="Healthcare Professional 2" style="width: auto; height: 250px; max-width: 100%; object-fit: cover; object-position: bottom; position: absolute; left: 120px; top: 0; z-index: 20; filter: drop-shadow(0 10px 8px rgba(0,0,0,0.1));" />
          </div>
        </mj-text>
      </mj-column>

    </mj-section>

    <!-- Main Content Area -->
    <mj-section background-color="#ffffff" padding="0 20px 32px 20px" max-width="600px">
      <mj-column width="100%" padding="64px 24px">
        {% block content %}{% endblock %}
      </mj-column>
    </mj-section>


    </mj-wrapper>
      </mj-column>
    </mj-section>
    <!-- Footer Section -->
    <mj-section padding="32px 20px 24px 20px" css-class="footer-wrapper">
      <mj-column width="100%" vertical-align="middle">
        <mj-text align="center" color="#9ca3af" font-size="13px" padding="0" css-class="footer-mobile">
          <span style="display: inline-block; margin: 0 15px;">Sent by Team {{ app_name }}</span>
          <span style="display: inline-block; margin: 0 15px;">{{ company_name }} {{ current_year }}</span>
          <span class="social-icons" style="display: inline-block; margin: 0 15px;">
            <a href="https://linkedin.com/company/hospitaljobsin" style="text-decoration: none; margin: 0 3px;">
              <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="LinkedIn" style="width: 16px; height: 16px; filter: invert(0.6);" />
            </a>
            <a href="https://facebook.com/hospitaljobsin" style="text-decoration: none; margin: 0 3px;">
              <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/facebook.svg" alt="Facebook" style="width: 16px; height: 16px; filter: invert(0.6);" />
            </a>
            <a href="https://instagram.com/hospitaljobsin" style="text-decoration: none; margin: 0 3px;">
              <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/instagram.svg" alt="Instagram" style="width: 16px; height: 16px; filter: invert(0.6);" />
            </a>
          </span>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- Bottom padding section -->
    <mj-section background-color="#E4E4E7" padding="0px 24px 24px 24px">
      <mj-column width="100%">
        <mj-text padding="0"></mj-text>
      </mj-column>
    </mj-section>
    <!-- End outer full-width grey container -->
  </mj-body>
</mjml>
