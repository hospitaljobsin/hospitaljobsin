{% extends "emails/base/body.mjml" %}

{% block title %}
Complete Your Profile - Upload Your Resume
{% endblock %}

{% block preview %}
Get personalized job recommendations - {{ app_name }}
{% endblock %}

{% block content %}
<mj-text font-size="24px" font-weight="700" color="#1f2937" padding="0 0 8px 0" line-height="1.3">
  Hey {{ user_name }},
</mj-text>

<mj-text font-size="16px" color="#4b5563" padding="0 0 32px 0" line-height="1.6">
  Thanks for joining {{ app_name }}. We're excited to help you find the perfect role.
</mj-text>

<mj-image src="https://illustrations.popsy.co/amber/remote-work.svg" alt="Upload Resume" width="280px" padding="0 0 32px 0" />

<mj-text align="center" font-size="20px" font-weight="600" color="#1f2937" padding="0 0 16px 0" line-height="1.4">
  Get AI-Powered Job Matches
</mj-text>

<mj-text align="center" font-size="16px" color="#6b7280" padding="0 0 32px 0" line-height="1.6">
  Upload your resume and our AI will analyze your experience to send you personalized job alerts that actually match what you're looking for.
</mj-text>

<mj-section padding="0 0 32px 0">
  <mj-column width="33.33%">
    <mj-text align="center" font-size="15px" color="#374151" padding="0 8px">
      <strong>One-Click Apply</strong><br/>
      <span style="color: #9ca3af; font-size: 14px;">Apply instantly to jobs</span>
    </mj-text>
  </mj-column>
  <mj-column width="33.33%">
    <mj-text align="center" font-size="15px" color="#374151" padding="0 8px">
      <strong>Get Discovered</strong><br/>
      <span style="color: #9ca3af; font-size: 14px;">Recruiters find you</span>
    </mj-text>
  </mj-column>
  <mj-column width="33.33%">
    <mj-text align="center" font-size="15px" color="#374151" padding="0 8px">
      <strong>Smart Alerts</strong><br/>
      <span style="color: #9ca3af; font-size: 14px;">Relevant job matches</span>
    </mj-text>
  </mj-column>
</mj-section>

<mj-button href="{{ upload_resume_url }}" padding="0 0 24px 0" width="100%" inner-padding="16px 24px" font-size="16px">
  Upload My Resume
</mj-button>

<mj-text font-size="14px" color="#9ca3af" padding="0" align="center" line-height="1.5">
  Takes less than a minute. Update anytime.
</mj-text>
{% endblock %}
