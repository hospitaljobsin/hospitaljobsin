{
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit"
		}
	},
	"ruff.nativeServer": true,
	"python.languageServer": "None",
	"python.analysis.typeCheckingMode": "standard",
	"python.analysis.autoImportCompletions": true,
	"python.analysis.showOnlyDirectDependenciesInAutoImport": true,
	"python.defaultInterpreterPath": "${workspaceFolder}/server/.venv/bin/python",
	"python.testing.pytestPath": "${workspaceFolder}/server/.venv/bin/python",
	"python.testing.cwd": "${workspaceFolder}/server",
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,
	"python.testing.pytestArgs": [""],
	"python.terminal.activateEnvironment": false,
	"files.exclude": {
		"**/.git": true,
		"**/.pytest_cache": true,
		"**/.mypy_cache": true,
		"**/.venv": true,
		"**/__pycache__": true,
		"**/.ruff_cache": true
	},
	"python.envFile": "${workspaceFolder}/server/.env"
}
